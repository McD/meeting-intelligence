#!/bin/bash
# claude-tcc-unstick — remediate macOS Sequoia auth_value=5 TCC rows for
# adhoc-signed binaries.
#
# Background: Sequoia writes auth_value=5 (pending re-auth / unresolved) when
# the user clicks Allow on a TCC prompt for an adhoc-signed CLI binary —
# Claude Code's per-version executable at ~/.local/share/claude/versions/X/,
# Homebrew's gtimeout, etc. auth_value=5 causes tccd to re-prompt on every
# access. The correct working value is auth_value=2 (allowed). The CSREQ
# blob in the row is valid (the user did consent and macOS recorded the
# binary identity); only the auth_value field is wrong.
#
# Strategy (revised 2026-06-02 after the 2.1.150 evidence):
#   - For stuck rows whose client path STILL EXISTS on disk: UPDATE
#     auth_value 5→2, preserving CSREQ. This is the actual fix — tccd
#     reads =2 and stops prompting. No re-prompt loop.
#   - For stuck rows whose client path is MISSING (pruned old versions,
#     uninstalled brew binaries): DELETE the row as orphan cleanup. There
#     is no binary left to grant.
#
# Prior versions of this script DELETEd everything. That caused a re-prompt
# loop on the current binary because the next Allow re-wrote auth_value=5.
#
# tccd watches TCC.db and reloads its cache; killall is not normally needed
# but `sudo killall tccd` forces a fresh load if a row seems sticky.
#
# Invocation:
#   claude-tcc-unstick           — apply fixes, exit 0
#   claude-tcc-unstick --dry-run — report what would change, exit 0
#   claude-tcc-unstick --check   — exit 1 if any stuck rows exist (for scripts)

set -e

DB="$HOME/Library/Application Support/com.apple.TCC/TCC.db"
LOG="$HOME/Briefings/scheduler.log"
SLACK_WEBHOOK=$(cat ~/.slack_webhook 2>/dev/null || true)

# Adhoc-signed CLI binary paths known to trip the Sequoia auth_value=5 bug.
# Anchored to path prefixes so unrelated Homebrew grants are never touched.
PATTERNS=(
    "/Users/$USER/.local/share/claude/versions/%"
    "/opt/homebrew/Cellar/coreutils/%/bin/gtimeout"
)

log() {
    local msg="$1"
    if [ -d "$(dirname "$LOG")" ]; then
        echo "[$(date '+%Y-%m-%d %H:%M')] claude-tcc-unstick: $msg" >> "$LOG"
    fi
    echo "$msg"
}

mode="apply"
case "${1:-}" in
    --dry-run) mode="dry" ;;
    --check)   mode="check" ;;
    --help|-h)
        head -30 "$0" | grep '^#' | sed 's/^# \?//'
        exit 0
        ;;
esac

# Build the WHERE clause from PATTERNS
where_clause="auth_value = 5 AND ("
sep=""
for p in "${PATTERNS[@]}"; do
    where_clause+="${sep}client LIKE '$p'"
    sep=" OR "
done
where_clause+=")"

# Pull stuck rows. Output: service<TAB>client per line.
stuck=$(sqlite3 -separator $'\t' "$DB" "SELECT service, client FROM access WHERE $where_clause;" 2>&1)

if [ -z "$stuck" ]; then
    if [ "$mode" = "check" ]; then
        exit 0
    fi
    log "no stuck rows"
    exit 0
fi

# Partition into "live" (path exists → UPDATE) and "orphan" (missing → DELETE)
live_rows=""
orphan_rows=""
while IFS=$'\t' read -r service client; do
    [ -z "$service" ] && continue
    if [ -e "$client" ]; then
        live_rows+="${service}|${client}"$'\n'
    else
        orphan_rows+="${service}|${client}"$'\n'
    fi
done <<< "$stuck"

live_count=0
orphan_count=0
[ -n "$live_rows" ]   && live_count=$(printf '%s' "$live_rows"   | grep -c '^')
[ -n "$orphan_rows" ] && orphan_count=$(printf '%s' "$orphan_rows" | grep -c '^')
total=$((live_count + orphan_count))

if [ "$mode" = "check" ]; then
    echo "$total stuck row(s) detected: $live_count live (will UPDATE), $orphan_count orphan (will DELETE):"
    [ -n "$live_rows" ]   && printf '%s' "$live_rows"   | sed 's/^/  live    /'
    [ -n "$orphan_rows" ] && printf '%s' "$orphan_rows" | sed 's/^/  orphan  /'
    exit 1
fi

if [ "$mode" = "dry" ]; then
    log "dry-run: would fix $total row(s) ($live_count UPDATE, $orphan_count DELETE):"
    [ -n "$live_rows" ]   && printf '%s' "$live_rows"   | sed 's/^/  live    /'
    [ -n "$orphan_rows" ] && printf '%s' "$orphan_rows" | sed 's/^/  orphan  /'
    exit 0
fi

# Apply.
#
# Live rows: UPDATE auth_value=2 while keeping CSREQ + auth_reason intact.
# Scope the UPDATE to the exact (service, client) pairs we identified so we
# don't promote any row outside our matched set even if the patterns ever
# widen unintentionally.
if [ -n "$live_rows" ]; then
    while IFS='|' read -r service client; do
        [ -z "$service" ] && continue
        # Single-quote escape for SQL
        s_esc=$(printf '%s' "$service" | sed "s/'/''/g")
        c_esc=$(printf '%s' "$client"  | sed "s/'/''/g")
        sqlite3 "$DB" "UPDATE access SET auth_value=2 WHERE auth_value=5 AND service='$s_esc' AND client='$c_esc';"
    done <<< "$live_rows"
fi

# Orphan rows: DELETE the dead grants outright.
if [ -n "$orphan_rows" ]; then
    while IFS='|' read -r service client; do
        [ -z "$service" ] && continue
        s_esc=$(printf '%s' "$service" | sed "s/'/''/g")
        c_esc=$(printf '%s' "$client"  | sed "s/'/''/g")
        sqlite3 "$DB" "DELETE FROM access WHERE auth_value=5 AND service='$s_esc' AND client='$c_esc';"
    done <<< "$orphan_rows"
fi

log "fixed $total stuck TCC row(s): $live_count UPDATEd to allowed, $orphan_count orphan DELETEd"
[ -n "$live_rows" ]   && printf '%s' "$live_rows"   | sed 's/^/  live    /' | tee -a "$LOG" >/dev/null
[ -n "$orphan_rows" ] && printf '%s' "$orphan_rows" | sed 's/^/  orphan  /' | tee -a "$LOG" >/dev/null

# Slack heads-up — only when something material changed
if [ -n "$SLACK_WEBHOOK" ] && [ "$total" -gt 0 ]; then
    payload=$(printf '{"text": ":wrench: TCC auto-fix: %s row(s) UPDATEd to allowed (live binary), %s orphan row(s) DELETEd. No re-prompt expected; if one fires, run `sudo killall tccd` to force a tccd cache reload."}' "$live_count" "$orphan_count")
    curl -s --connect-timeout 5 --max-time 10 -X POST "$SLACK_WEBHOOK" \
         -H 'Content-type: application/json' -d "$payload" >/dev/null || true
fi
